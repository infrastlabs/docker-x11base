--- a/gtk/gtkprintbackend.c
+++ b/gtk/gtkprintbackend.c
@@ -107,6 +107,30 @@ struct _GtkPrintBackendModuleClass
   GTypeModuleClass parent_class;
 };
 
+/* Static builtin print backends (lxtask static link, no dlopen).
+ * Symbols provided by libstatic-printbackend-file.a / -lpr.a (renamed to avoid
+ * pb_module_init/exit/create clash among backends). Mirrors gtkimmodule.c
+ * builtin-module pattern. */
+typedef struct {
+  const gchar *name;
+  void (*init) (GTypeModule *module);
+  void (*exit) (void);
+  GtkPrintBackend *(*create) (void);
+} GtkPrintBackendBuiltin;
+
+extern void _gtk_print_backend_file_init (GTypeModule *module);
+extern void _gtk_print_backend_file_exit (void);
+extern GtkPrintBackend *_gtk_print_backend_file_create (void);
+extern void _gtk_print_backend_lpr_init (GTypeModule *module);
+extern void _gtk_print_backend_lpr_exit (void);
+extern GtkPrintBackend *_gtk_print_backend_lpr_create (void);
+
+static const GtkPrintBackendBuiltin print_backend_builtins[] = {
+  { "file", _gtk_print_backend_file_init, _gtk_print_backend_file_exit, _gtk_print_backend_file_create },
+  { "lpr",  _gtk_print_backend_lpr_init,  _gtk_print_backend_lpr_exit,  _gtk_print_backend_lpr_create },
+  { NULL, NULL, NULL, NULL }
+};
+
 G_DEFINE_TYPE (GtkPrintBackendModule, _gtk_print_backend_module, G_TYPE_TYPE_MODULE)
 #define GTK_TYPE_PRINT_BACKEND_MODULE      (_gtk_print_backend_module_get_type ())
 #define GTK_PRINT_BACKEND_MODULE(module)   (G_TYPE_CHECK_INSTANCE_CAST ((module), GTK_TYPE_PRINT_BACKEND_MODULE, GtkPrintBackendModule))
@@ -119,6 +143,25 @@ gtk_print_backend_module_load (GTypeModule *module)
   GtkPrintBackendModule *pb_module = GTK_PRINT_BACKEND_MODULE (module); 
   gpointer initp, exitp, createp;
  
+  if (pb_module->path == NULL)   /* builtin backend: no dlopen */
+    {
+      const GtkPrintBackendBuiltin *b = print_backend_builtins;
+      while (b->name)
+        {
+          if (strcmp (G_TYPE_MODULE (module)->name, b->name) == 0)
+            {
+              pb_module->init = b->init;
+              pb_module->exit = b->exit;
+              pb_module->create = b->create;
+              pb_module->init (module);
+              return TRUE;
+            }
+          b++;
+        }
+      g_warning ("Unknown builtin print backend %s", G_TYPE_MODULE (module)->name);
+      return FALSE;
+    }
+
   pb_module->library = g_module_open (pb_module->path, G_MODULE_BIND_LAZY | G_MODULE_BIND_LOCAL);
   if (!pb_module->library)
     {
@@ -158,7 +201,8 @@ gtk_print_backend_module_unload (GTypeModule *module)
   
   pb_module->exit();
 
-  g_module_close (pb_module->library);
+  if (pb_module->library)
+    g_module_close (pb_module->library);
   pb_module->library = NULL;
 
   pb_module->init = NULL;
@@ -272,6 +316,26 @@ _gtk_print_backend_create (const gchar *backend_name)
     }
 
   pb = NULL;
+
+  /* builtin backends first (static link, no dlopen) */
+  {
+    const GtkPrintBackendBuiltin *b = print_backend_builtins;
+    while (b->name)
+      {
+        if (strcmp (b->name, backend_name) == 0)
+          {
+            pb_module = g_object_new (GTK_TYPE_PRINT_BACKEND_MODULE, NULL);
+            g_type_module_set_name (G_TYPE_MODULE (pb_module), backend_name);
+            pb_module->path = NULL;   /* builtin marker */
+            loaded_backends = g_slist_prepend (loaded_backends, pb_module);
+            g_type_module_use (G_TYPE_MODULE (pb_module));   /* keep loaded (builtin never unloads) */
+            pb = _gtk_print_backend_module_create (pb_module);
+            return pb;
+          }
+        b++;
+      }
+  }
+
   if (g_module_supported ())
     {
       full_name = g_strconcat ("printbackend-", backend_name, NULL);
@@ -332,12 +396,16 @@ gtk_print_backend_load_modules (void)
     {
       g_strchug (backends[i]);
       g_strchomp (backends[i]);
+      fprintf (stderr, "[lm] i=%d name=%s before create result=%p\n", i, backends[i], result);
       backend = _gtk_print_backend_create (backends[i]);
+      fprintf (stderr, "[lm] i=%d after create backend=%p\n", i, backend);
       
       if (backend)
         result = g_list_append (result, backend);
+      fprintf (stderr, "[lm] i=%d after append result=%p\n", i, result);
     }
 
+  fprintf (stderr, "[lm] before return result=%p\n", result);
   g_strfreev (backends);
   g_free (setting);
 
