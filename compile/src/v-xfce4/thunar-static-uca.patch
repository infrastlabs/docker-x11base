       g_dir_close (dp);
     }
 
+#ifdef THUNARX_STATIC_UCA
+  /* register the built-in statically linked UCA extension */
+  {
+    ThunarxProviderModule *builtin;
+
+    builtin = thunarx_provider_module_new ("static-uca");
+    thunarx_provider_modules = g_list_prepend (thunarx_provider_modules, builtin);
+    if (g_type_module_use (G_TYPE_MODULE (builtin)))
+      {
+        thunarx_provider_factory_add (factory, builtin);
+        modules = g_list_prepend (modules, builtin);
+      }
+  }
+#endif
+
   return modules;
 }
 
