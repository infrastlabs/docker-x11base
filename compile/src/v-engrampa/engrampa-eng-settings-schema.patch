+
+/* engrampa-static: GSettings schema 目录编译期编入（产物可迁移、运行时免 XDG_DATA_DIRS） */
+#include <gio/gio.h>
+#ifndef ENG_SCHEMA_DIR
+# define ENG_SCHEMA_DIR "/usr/share/glib-2.0/schemas"
+#endif
+
+static GSettingsSchemaSource *eng_schema_source (void)
+{
+	static GSettingsSchemaSource *source = NULL;
+	if (source) {
+		g_settings_schema_source_ref (source);
+		return source;
+	}
+	source = g_settings_schema_source_new_from_directory (ENG_SCHEMA_DIR, NULL, TRUE, NULL);
+	if (source)
+		g_settings_schema_source_ref (source);
+	return source;
+}
+
+GSettings *
+eng_settings_new (const char *schema)
+{
+	GSettingsSchemaSource *source;
+	GSettingsSchema       *g_schema;
+	GSettings            *settings;
+
+	if (!schema)
+		return NULL;
+	source = eng_schema_source ();
+	if (source) {
+		g_schema = g_settings_schema_source_lookup (source, schema, TRUE);
+		if (g_schema) {
+			settings = g_settings_new_full (g_schema, NULL, NULL);
+			g_settings_schema_unref (g_schema);
+			if (settings)
+				return settings;
+		}
+	}
+	return g_settings_new (schema);
+}
