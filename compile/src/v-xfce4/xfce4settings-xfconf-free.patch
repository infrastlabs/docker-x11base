+static void
+xfce_randr_apply_native (XfceRandr *randr)
+{
+    Display *xdisplay;
+    XRRScreenResources *resources;
+    guint m;
+
+    g_return_if_fail (randr != NULL);
+    xdisplay = GDK_DISPLAY_XDISPLAY (randr->priv->display);
+    resources = randr->priv->resources;
+    if (G_UNLIKELY (xdisplay == NULL || resources == NULL || randr->priv->output_ids == NULL))
+        return;
+
+    /* 直接应用每个开启 output 的 mode/position/rotation（免 xfsettingsd 中转） */
+    for (m = 0; m < randr->noutput; m++)
+    {
+        RROutput out_id;
+        RRCrtc crtc;
+        guint n;
+
+        if (randr->mode[m] == None)
+            continue;
+        n = randr->priv->output_ids[m];
+        if (n >= resources->noutput)
+            continue;
+        out_id = resources->outputs[n];
+        crtc = randr->priv->output_info[m]->crtc;
+        if (crtc == None)
+            continue;
+        XRRSetCrtcConfig (xdisplay, resources, crtc, CurrentTime,
+                          randr->position[m].x, randr->position[m].y,
+                          randr->mode[m], randr->rotation[m],
+                          &out_id, 1);
+    }
+    XFlush (xdisplay);
+}
+
 void
 xfce_randr_apply (XfceRandr     *randr,
                   const gchar   *scheme,
                   XfconfChannel *channel)
 {
     g_return_if_fail (randr != NULL && scheme != NULL);
-    g_return_if_fail (XFCONF_IS_CHANNEL (channel));
 
-    /* tell the helper to apply this theme */
-    xfconf_channel_set_string (channel, "/Schemes/Apply", scheme);
+    /* FIXME(xfsettingsd-free): 直接应用 RandR（免 xfsettingsd 中转）；channel 可 NULL */
+    xfce_randr_apply_native (randr);
+
+    /* 若 xfconf daemon 在则写配置（兼容），否则仅直接应用 */
+    if (channel != NULL && XFCONF_IS_CHANNEL (channel))
+        xfconf_channel_set_string (channel, "/Schemes/Apply", scheme);
 }
 
 
