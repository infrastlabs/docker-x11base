+    g_type_ensure(gtk_dialog_get_type());
+    g_type_ensure(gtk_about_dialog_get_type());
+    g_type_ensure(gtk_image_get_type());
+    g_type_ensure(gtk_box_get_type());
+    g_type_ensure(gtk_label_get_type());
