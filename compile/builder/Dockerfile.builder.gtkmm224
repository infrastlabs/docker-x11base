ARG COMPILE_IMG=alpine-compile
ARG REPO=
FROM ${REPO}infrastlabs/x11-base:alpine-builder-gtk224-2 AS base
# FROM infrastlabs/x11-base:builder AS base
  ARG TARGETPLATFORM
  ENV CACHE=/usr/local/static/.cache
  ARG NOCACHE
  RUN echo "NOCACHE.gtkmm=${NOCACHE}" >> /tmp/NOCACHE; \
    apk update; apk add icu-static icu-dev libjpeg-turbo-static jpeg-dev;
  # COPY --from=compile /rootfs${CACHE} ${CACHE}
  COPY ./tarsrc /tarsrc
  COPY ./src /src
  RUN chmod +x /src/**/*.sh; \
    ls -lh /src/**/*.sh
  # openbox/build(fontconfig,Xrandr,pango); xcompmgr/build(Xdamage);  u-gtk/build(atk,gdk,gtk); u-gtkmm/build(gtkmm栈); w-xlunch/build(imlib2)
  # use: lxde,pcmanfm, geany, tint2, xfce414
  # RUN bash /src/u-gtk/build.sh b_deps
  ############################################### 
  #   pavucontrol, gnome-system-monitor(gtkmm链)
  #   feh/scrot/hsetroot/tint2/xlunch(imlib2)
  # gtkmm 栈(7组件+mm-common)静态, 供 pavucontrol/gsm 复用(--prefix=/usr, .a 落 /usr/lib); ICU 供 rime(ibus-rime) 链
  RUN bash /src/u-gtkmm/build.sh full
  RUN \
    # 2026-11-27(4.1.5 R1): 原「保留 /tmp/gtk + /tmp/gtkmm-src + /tmp/imlib2 源树做增量复用」机制废弃——\n    #   SRCROOT 落地后源码树归 $SRCROOT(串行=/tmp, 并行=$WS/src), 增量复用判断在脚本内(.git+config.status),\n    #   不再依赖跨 stage 保留 /tmp/gtk 等; /usr/lib/*.a 成品绝对保留(§5.2 gtk2 .a 禁清); 只清可清中间产物.\n    rm -rf /var/cache/apk/* /root/.cache; \\\n    rm -f /tmp/*.log /tmp/*.out /usr/local/static/.cache/libexif-0.6.23.tar.bz2

