+gboolean gsm_procman_quitting = FALSE;
+
+gboolean
+cb_app_configure (GtkWidget *widget, GdkEventConfigure *event, gpointer data)
+{
+	(void)widget;
+	ProcData * const procdata = static_cast<ProcData*>(data);
+
+	if (!procdata || !event)
+		return FALSE;
+	if (procdata->client) {
+		gconf_client_set_int (procdata->client, "/apps/procman/width", event->width, NULL);
+		gconf_client_set_int (procdata->client, "/apps/procman/height", event->height, NULL);
+	}
+	return FALSE;
+}
+
 void
+gsm_procman_app_destroyed (GtkWidget *widget)
+{
+	(void)widget;
+	gsm_procman_quitting = TRUE;
+	gtk_main_quit ();
+}
