diff --git a/gtk/gtkbuilder.c b/gtk/gtkbuilder.c
index 0ef6087..85e1f21 100644
--- a/gtk/gtkbuilder.c
+++ b/gtk/gtkbuilder.c
@@ -171,6 +171,62 @@ gtk_builder_get_property (GObject    *object,
 }
 
 
+
+#include <gtk/gtk.h>
+#include <atk/atk.h>
+
+static GType
+_gtk_builder_static_type_func (const gchar *name)
+{
+  static const struct { const gchar *name; GTypeGetFunc func; } table[] = {
+    { "AtkObject", atk_object_get_type },
+    { "GtkAccelGroup", gtk_accel_group_get_type },
+    { "GtkAdjustment", gtk_adjustment_get_type },
+    { "GtkAlignment", gtk_alignment_get_type },
+    { "GtkButton", gtk_button_get_type },
+    { "GtkCellRendererText", gtk_cell_renderer_text_get_type },
+    { "GtkCheckButton", gtk_check_button_get_type },
+    { "GtkCheckMenuItem", gtk_check_menu_item_get_type },
+    { "GtkColorButton", gtk_color_button_get_type },
+    { "GtkComboBox", gtk_combo_box_get_type },
+    { "GtkDialog", gtk_dialog_get_type },
+    { "GtkEntry", gtk_entry_get_type },
+    { "GtkEventBox", gtk_event_box_get_type },
+    { "GtkFontButton", gtk_font_button_get_type },
+    { "GtkFrame", gtk_frame_get_type },
+    { "GtkHBox", gtk_hbox_get_type },
+    { "GtkHButtonBox", gtk_hbutton_box_get_type },
+    { "GtkHPaned", gtk_hpaned_get_type },
+    { "GtkImage", gtk_image_get_type },
+    { "GtkImageMenuItem", gtk_image_menu_item_get_type },
+    { "GtkLabel", gtk_label_get_type },
+    { "GtkListStore", gtk_list_store_get_type },
+    { "GtkMenu", gtk_menu_get_type },
+    { "GtkMenuBar", gtk_menu_bar_get_type },
+    { "GtkMenuItem", gtk_menu_item_get_type },
+    { "GtkNotebook", gtk_notebook_get_type },
+    { "GtkRadioButton", gtk_radio_button_get_type },
+    { "GtkRadioMenuItem", gtk_radio_menu_item_get_type },
+    { "GtkScrolledWindow", gtk_scrolled_window_get_type },
+    { "GtkSeparatorMenuItem", gtk_separator_menu_item_get_type },
+    { "GtkSpinButton", gtk_spin_button_get_type },
+    { "GtkStatusbar", gtk_statusbar_get_type },
+    { "GtkTable", gtk_table_get_type },
+    { "GtkTextBuffer", gtk_text_buffer_get_type },
+    { "GtkTextView", gtk_text_view_get_type },
+    { "GtkTreeView", gtk_tree_view_get_type },
+    { "GtkVBox", gtk_vbox_get_type },
+    { "GtkVPaned", gtk_vpaned_get_type },
+    { "GtkViewport", gtk_viewport_get_type },
+    { "GtkWindow", gtk_window_get_type },
+  };
+  guint i;
+  for (i = 0; i < G_N_ELEMENTS (table); i++)
+    if (g_ascii_strcasecmp (name, table[i].name) == 0)
+      return table[i].func ();
+  return NULL;
+}
+
 /*
  * Try to map a type name to a _get_type function
  * and call it, eg:
@@ -209,9 +265,16 @@ _gtk_builder_resolve_type_lazily (const gchar *name)
   
   symbol = g_string_free (symbol_name, FALSE);
 
-  if (g_module_symbol (module, symbol, (gpointer)&func))
+  if (module && g_module_symbol (module, symbol, (gpointer)&func))
     gtype = func ();
-  
+  else
+    {
+      /* static binary: dlsym can't find symbols -> compile-time table */
+      GType sgtype = _gtk_builder_static_type_func (name);
+      if (sgtype != G_TYPE_INVALID)
+        gtype = sgtype;
+    }
+
   g_free (symbol);
 
   return gtype;
