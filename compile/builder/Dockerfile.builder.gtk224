ARG COMPILE_IMG=alpine-compile
ARG REPO=
FROM ${REPO}infrastlabs/x11-base:alpine-builder AS base
# FROM infrastlabs/x11-base:builder AS base
  ARG TARGETPLATFORM
  ENV \
    CACHE=/usr/local/static/.cache \
    DOEXEC_CALLER=u-gtk
  RUN sed -i 's|http://mirrors.ustc.edu.cn|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apk/repositories; \
    apk update; apk add gawk git;
  # COPY --from=compile /rootfs${CACHE} ${CACHE}
  COPY ./src /src
  # openbox/build(fontconfig,Xrandr,pango); xcompmgr/build(Xdamage);  u-gtk/build(atk,gdk,gtk)
  # use: lxde,pcmanfm, geany, tint2, xfce414
  RUN chmod +x /src/**/*.sh; \
    ls -lh /src/**/*.sh
  RUN bash /src/u-gtk/build.sh b_deps



