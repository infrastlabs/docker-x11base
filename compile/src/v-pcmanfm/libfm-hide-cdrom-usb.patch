+/* 2026-11-23 项目场景: 屏蔽 cdrom/usb 侧栏设备（当下及项目用不着）*/
+static gboolean _hide_cdrom_usb(GObject* volume_or_mount)
+{
+    const char* name = NULL;
+    char* path = NULL;
+    GFile* root = NULL;
+    char* lower = NULL;
+    gboolean ret = FALSE;
+    if(G_IS_VOLUME(volume_or_mount))
+        name = g_volume_get_name(G_VOLUME(volume_or_mount));
+    else if(G_IS_MOUNT(volume_or_mount))
+    {
+        name = g_mount_get_name(G_MOUNT(volume_or_mount));
+        root = g_mount_get_root(G_MOUNT(volume_or_mount));
+        if(root) path = g_file_get_path(root);
+    }
+    if(name)
+    {
+        lower = g_ascii_strdown(name, -1);
+        if(strstr(lower, "cdrom") || strstr(lower, "cd-rom") || strstr(lower, "usb"))
+            ret = TRUE;
+    }
+    if(path && (strstr(path, "/media/cdrom") || strstr(path, "/media/usb")))
+        ret = TRUE;
+    g_free(lower);
+    g_free(path);
+    if(root) g_object_unref(root);
+    return ret;
+}
